{%- if block.settings.link != blank -%}
  <a class="neu-trust__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
    {% render 'neu-icon', icon: block.settings.icon %}
    <span>{{ block.settings.label | escape }}</span>
  </a>
{%- else -%}
  <div class="neu-trust__item" {{ block.shopify_attributes }}>
    {% render 'neu-icon', icon: block.settings.icon %}
    <span>{{ block.settings.label | escape }}</span>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Trust icon",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "shield", "label": "Shield" },
        { "value": "medal", "label": "Medal" },
        { "value": "refresh", "label": "Refresh" },
        { "value": "box", "label": "Box" },
        { "value": "truck", "label": "Delivery" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "check", "label": "Check" }
      ],
      "default": "shield"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "UK-Made"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [{ "name": "Trust icon" }]
}
{% endschema %}
