{%- liquid
  assign p = closest.product | default: product
  assign v = p.selected_or_first_available_variant
  assign s = block.settings
  assign type = s.plan_type
  assign months = s.billing_months | default: 1 | at_least: 1
  assign servings = s.servings | default: 1 | at_least: 1
  assign plan_id = ''
  assign target_variant = v
  assign pack = s.pack | strip

  # The pack value (e.g. "24 Shots") picks the variant: same flavour as the current selection, this card's pack
  if pack != blank and type != 'product'
    assign pack_index = -1
    for option in p.options_with_values
      for value in option.values
        if value.name == pack
          assign pack_index = forloop.parentloop.index0
        endif
      endfor
    endfor
    if pack_index >= 0
      for candidate in p.variants
        assign matches = true
        for value in candidate.options
          if forloop.index0 == pack_index
            if value != pack
              assign matches = false
            endif
          elsif value != v.options[forloop.index0]
            assign matches = false
          endif
        endfor
        if matches
          assign target_variant = candidate
          break
        endif
      endfor
    endif
  endif
  assign plan_price = target_variant.price

  # A pack card sells its variant once, plus Subscribe & Save when the variant has a selling plan
  if type == 'subscription' or type == 'pack'
    assign wanted_id = s.selling_plan_id | strip
    for allocation in target_variant.selling_plan_allocations
      assign this_id = allocation.selling_plan.id | append: ''
      if wanted_id != blank and this_id == wanted_id
        assign plan_id = this_id
        assign plan_price = allocation.price
        break
      elsif wanted_id == blank and forloop.index == s.plan_position
        assign plan_id = this_id
        assign plan_price = allocation.price
        break
      endif
    endfor
  endif
  assign one_time_price = target_variant.price
  assign has_toggle = false
  assign subscribe_selected = false
  if type == 'pack'
    if plan_id != blank
      assign has_toggle = true
      assign subscribe_selected = s.subscribe_by_default
    endif
    unless subscribe_selected
      assign plan_price = one_time_price
    endunless
  endif

  if type == 'product' and s.product != blank
    assign target_variant = s.product.selected_or_first_available_variant
    assign plan_price = target_variant.price
  endif

  if s.show_per_month
    assign display_price = plan_price | divided_by: months
  else
    assign display_price = plan_price
  endif
  assign per_day = plan_price | divided_by: servings
  assign per_label = s.per_label | default: '/day'
  if type == 'pack'
    assign display_price = one_time_price
    assign per_day = one_time_price | divided_by: servings
  endif

  assign baseline = target_variant.price | times: months
  assign save_percent = 0
  if type == 'subscription' or has_toggle
    assign sub_price = plan_price
    if has_toggle
      for allocation in target_variant.selling_plan_allocations
        assign this_id = allocation.selling_plan.id | append: ''
        if this_id == plan_id
          assign sub_price = allocation.price
        endif
      endfor
    endif
  endif
  if type == 'subscription' and baseline > plan_price
    assign save_percent = baseline | minus: plan_price | times: 100.0 | divided_by: baseline | round
  endif

  assign radio_id = 'NeuPlan-' | append: block.id
-%}

<div
  class="neu-plan{% if s.selected %} is-selected{% endif %}"
  data-plan
  data-plan-type="{{ type }}"
  data-plan-id="{{ plan_id }}"
  data-wanted-plan-id="{{ s.selling_plan_id | strip }}"
  data-plan-position="{{ s.plan_position }}"
  data-pack="{{ pack | escape }}"
  data-variant-id="{% if type == 'product' %}{{ target_variant.id }}{% endif %}"
  data-fixed-price="{% if type == 'product' %}{{ plan_price }}{% endif %}"
  data-months="{{ months }}"
  data-servings="{{ servings }}"
  data-per-month="{{ s.show_per_month }}"
  data-per-label="{{ per_label | escape }}"
  {{ block.shopify_attributes }}
>
  {%- if s.badge != blank -%}
    <span class="neu-plan__badge">
      {% render 'neu-icon', icon: 'star-filled' %}
      {{ s.badge | escape }}
    </span>
  {%- endif -%}

  <span class="neu-plan__body">
    <span class="neu-plan__row">
      <input
        class="neu-plan__radio"
        type="radio"
        name="neu-plan"
        id="{{ radio_id }}"
        aria-labelledby="{{ radio_id }}-title"
        {% if s.selected %}
          checked
        {% endif %}
      >
      <span>
        <span class="neu-plan__title" id="{{ radio_id }}-title">
          {{ s.title | escape }}
          {%- if type == 'subscription' -%}
            <span class="neu-save" data-plan-save{% if save_percent <= 0 %} hidden{% endif %}>Save {{ save_percent }}%</span>
          {%- endif -%}
        </span>
        {%- if s.subtitle != blank -%}
          <span class="neu-plan__subtitle{% if s.subtitle_accent %} neu-plan__subtitle--accent{% endif %}">{{ s.subtitle | escape }}</span>
        {%- endif -%}
      </span>
      <span class="neu-plan__price">
        <span class="neu-plan__amount">
          <span data-plan-amount>{{ display_price | money }}</span>
          {%- if s.show_per_month -%}/mo{%- endif -%}
        </span>
        <span class="neu-plan__per" data-plan-per>
          {{- per_day | money }}{{ per_label }}
          {%- if months > 1 %} · {{ months }}mo = {{ plan_price | money }}{% endif -%}
        </span>
        {%- if s.price_note != blank -%}
          <span class="neu-plan__note">{{ s.price_note | escape }}</span>
        {%- endif -%}
      </span>
    </span>

    {%- if s.perks != blank -%}
      {%- assign perks = s.perks | newline_to_br | split: '<br />' -%}
      <ul class="neu-plan__perks{% if s.perks_inline %} neu-plan__perks--inline{% endif %}">
        {%- for perk in perks -%}
          {%- assign perk_text = perk | strip -%}
          {%- if perk_text != blank -%}
            {%- liquid
              assign icon = 'check'
              if s.perks_inline
                assign perk_lower = perk_text | downcase
                if perk_lower contains 'taste'
                  assign icon = 'leaf'
                elsif perk_lower contains 'select' or perk_lower contains 'favourite'
                  assign icon = 'tag'
                elsif perk_lower contains 'off'
                  assign icon = 'gift'
                endif
              endif
            -%}
            <li>{% render 'neu-icon', icon: icon %}<span>{{ perk_text | escape }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.chips != blank -%}
      {%- assign chips = s.chips | newline_to_br | split: '<br />' -%}
      <span class="neu-chips">
        {%- for chip in chips -%}
          {%- assign chip_text = chip | strip -%}
          {%- if chip_text != blank -%}
            {%- liquid
              assign chip_lower = chip_text | downcase
              assign icon = 'gift'
              if chip_lower contains 'postage' or chip_lower contains 'delivery' or chip_lower contains 'shipping'
                assign icon = 'truck'
              elsif chip_lower contains 'sock'
                assign icon = 'socks'
              elsif chip_lower contains 'bottle'
                assign icon = 'bottle'
              endif
            -%}
            <span class="neu-chip">{% render 'neu-icon', icon: icon %}{{ chip_text | escape }}</span>
          {%- endif -%}
        {%- endfor -%}
      </span>
    {%- endif -%}

    {%- if has_toggle -%}
      {%- liquid
        assign toggle_save = 0
        if one_time_price > sub_price
          assign toggle_save = one_time_price | minus: sub_price | times: 100.0 | divided_by: one_time_price | round
        endif
      -%}
      <span class="neu-purchase" role="radiogroup" aria-label="{{ s.title | escape }}">
        <label class="neu-purchase__option">
          <input
            type="radio"
            name="neu-purchase-{{ block.id }}"
            value="subscription"
            data-purchase
            {% if subscribe_selected %}
              checked
            {% endif %}
          >
          <span class="neu-purchase__label">
            {{ s.subscribe_label | escape }}
            {%- if toggle_save > 0 %} <span class="neu-save" data-purchase-save>Save {{ toggle_save }}%</span>{% endif -%}
          </span>
          <span class="neu-purchase__price">
            <span data-purchase-price="subscription">{{ sub_price | money }}</span>
            {%- if s.subscribe_note != blank -%}
              <span class="neu-purchase__note">{{ s.subscribe_note | escape }}</span>
            {%- endif -%}
          </span>
        </label>
        <label class="neu-purchase__option">
          <input
            type="radio"
            name="neu-purchase-{{ block.id }}"
            value="one_time"
            data-purchase
            {% unless subscribe_selected %}
              checked
            {% endunless %}
          >
          <span class="neu-purchase__label">{{ s.one_time_label | escape }}</span>
          <span class="neu-purchase__price">
            <span data-purchase-price="one_time">{{ one_time_price | money }}</span>
            {%- if s.one_time_note != blank -%}
              <span class="neu-purchase__note">{{ s.one_time_note | escape }}</span>
            {%- endif -%}
          </span>
        </label>
      </span>
      {%- if s.subscribe_footnote != blank -%}
        <span class="neu-purchase__footnote">{{ s.subscribe_footnote | escape }}</span>
      {%- endif -%}
    {%- endif -%}
  </span>
</div>

{% schema %}
{
  "name": "Plan",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "plan_type",
      "label": "Plan type",
      "options": [
        { "value": "subscription", "label": "Subscription (selling plan)" },
        { "value": "one_time", "label": "One-time purchase" },
        { "value": "pack", "label": "Pack: one-time, plus Subscribe & Save when the variant has a selling plan" },
        { "value": "product", "label": "Different product (e.g. discovery pack)" }
      ],
      "default": "subscription"
    },
    {
      "type": "text",
      "id": "pack",
      "label": "Pack type",
      "info": "The product option value this card buys, e.g. 24 Shots. The flavour comes from the flavour picker."
    },
    {
      "type": "text",
      "id": "selling_plan_id",
      "label": "Selling plan ID",
      "info": "From Appstle. Leave blank to use the selling plan position below."
    },
    {
      "type": "number",
      "id": "plan_position",
      "label": "Selling plan position",
      "info": "1 = the product's first selling plan. Used when the ID is blank.",
      "default": 1
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Only for the 'Different product' plan type"
    },
    {
      "type": "checkbox",
      "id": "selected",
      "label": "Selected by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "info": "Black bar above the card, e.g. Best value"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "28-Day Subscription"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "checkbox",
      "id": "subtitle_accent",
      "label": "Green subtitle",
      "default": false
    },
    {
      "type": "textarea",
      "id": "perks",
      "label": "Perks",
      "info": "One per line"
    },
    {
      "type": "checkbox",
      "id": "perks_inline",
      "label": "Compact perks row",
      "default": false
    },
    {
      "type": "textarea",
      "id": "chips",
      "label": "Chips",
      "info": "One per line, e.g. Free postage. Icon is picked from the words postage, socks or bottle."
    },
    {
      "type": "header",
      "content": "Pricing display"
    },
    {
      "type": "number",
      "id": "servings",
      "label": "Shots per delivery",
      "info": "Used for the per-day price",
      "default": 28
    },
    {
      "type": "number",
      "id": "billing_months",
      "label": "Months per delivery",
      "info": "3 for a quarterly plan. Savings compare against this many one-time packs.",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "show_per_month",
      "label": "Show price per month",
      "default": true
    },
    {
      "type": "text",
      "id": "per_label",
      "label": "Per-serving label",
      "info": "Follows the per-serving price, e.g. /day or  per shot",
      "default": "/day"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Note under price",
      "info": "e.g. + Postage"
    },
    {
      "type": "header",
      "content": "Subscribe & Save (Pack plan type)"
    },
    {
      "type": "checkbox",
      "id": "subscribe_by_default",
      "label": "Subscribe & Save selected by default",
      "default": true
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscribe label",
      "default": "Subscribe & save"
    },
    {
      "type": "text",
      "id": "subscribe_note",
      "label": "Subscribe note",
      "default": "Free delivery"
    },
    {
      "type": "text",
      "id": "one_time_label",
      "label": "One-time label",
      "default": "Buy once"
    },
    {
      "type": "text",
      "id": "one_time_note",
      "label": "One-time note",
      "info": "e.g. + £3.50 delivery"
    },
    {
      "type": "text",
      "id": "subscribe_footnote",
      "label": "Footnote",
      "default": "Cancel or change anytime. No commitment."
    }
  ],
  "presets": [
    {
      "name": "Plan"
    }
  ]
}
{% endschema %}
