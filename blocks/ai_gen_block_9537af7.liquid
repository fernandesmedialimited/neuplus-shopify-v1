{% doc %}
  @prompt
    'AS SEEN IN' Headline
    3 logos (3 columns with a logo in each) 
    + Title and description
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-as-seen-in-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-as-seen-in-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-as-seen-in-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-as-seen-in-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    text-transform: {{ block.settings.headline_transform }};
    letter-spacing: {{ block.settings.headline_letter_spacing }}px;
  }

  .ai-as-seen-in-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.description_spacing }}px 0;
  }

  .ai-as-seen-in-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-as-seen-in-logos-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.logo_gap }}px;
    align-items: center;
    margin-top: {{ block.settings.logos_spacing }}px;
  }

  .ai-as-seen-in-logo-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.logo_padding }}px;
  }

  .ai-as-seen-in-logo-item-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
    max-height: {{ block.settings.logo_max_height }}px;
    object-fit: contain;
    opacity: {{ block.settings.logo_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  .ai-as-seen-in-logo-item-{{ ai_gen_id }} img:hover {
    opacity: 1;
  }

  .ai-as-seen-in-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: 200px;
    height: {{ block.settings.logo_max_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-as-seen-in-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-as-seen-in-logos-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.logo_gap_mobile }}px;
    }

    .ai-as-seen-in-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-as-seen-in-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-as-seen-in-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<as-seen-in-{{ ai_gen_id }} class="ai-as-seen-in-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-as-seen-in-container-{{ ai_gen_id }}">
    <div class="ai-as-seen-in-header-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-as-seen-in-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.title != blank %}
        <h3 class="ai-as-seen-in-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-as-seen-in-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="ai-as-seen-in-logos-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign logo_key = 'logo_' | append: i
          assign logo = block.settings[logo_key]
        %}
        <div class="ai-as-seen-in-logo-item-{{ ai_gen_id }}">
          {% if logo != blank %}
            <img
              src="{{ logo | image_url: width: 400 }}"
              alt="{{ logo.alt | escape }}"
              loading="lazy"
              width="{{ logo.width }}"
              height="{{ logo.height }}"
            >
          {% else %}
            <div class="ai-as-seen-in-logo-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</as-seen-in-{{ ai_gen_id }}>

<script>
  (function() {
    class AsSeenIn{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('as-seen-in-{{ ai_gen_id }}', AsSeenIn{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "As seen in",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "AS SEEN IN"
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Headline size",
      "min": 10,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "headline_transform",
      "label": "Headline text case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "headline_letter_spacing",
      "label": "Headline letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Title and description"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "image_picker",
      "id": "logo_1",
      "label": "Logo 1"
    },
    {
      "type": "image_picker",
      "id": "logo_2",
      "label": "Logo 2"
    },
    {
      "type": "image_picker",
      "id": "logo_3",
      "label": "Logo 3"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo max height",
      "min": 30,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "logo_padding",
      "label": "Logo padding",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
