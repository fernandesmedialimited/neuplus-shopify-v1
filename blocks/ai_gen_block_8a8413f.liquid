{% doc %}
  @prompt
    meet the team section, 6 profiles with image, title and role
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-team-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-team-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-team-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_bottom_margin }}px;
  }

  .ai-team-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    max-width: 800px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  .ai-team-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-team-member-{{ ai_gen_id }} {
    text-align: {{ block.settings.card_text_alignment }};
  }

  .ai-team-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin-bottom: {{ block.settings.image_spacing }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-team-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-team-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-team-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-team-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    color: {{ block.settings.name_color }};
    margin: 0 0 {{ block.settings.name_spacing }}px;
    font-weight: 600;
  }

  .ai-team-role-{{ ai_gen_id }} {
    font-size: {{ block.settings.role_size }}px;
    color: {{ block.settings.role_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-team-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-team-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-team-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 0;
    }

    .ai-team-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-team-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<team-section-{{ ai_gen_id }} class="ai-team-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.section_title != blank or block.settings.section_description != blank %}
    <div class="ai-team-header-{{ ai_gen_id }}">
      {% if block.settings.section_title != blank %}
        <h2 class="ai-team-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      {% endif %}
      {% if block.settings.section_description != blank %}
        <div class="ai-team-description-{{ ai_gen_id }}">{{ block.settings.section_description }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-team-grid-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign image_key = 'member_' | append: i | append: '_image'
        assign name_key = 'member_' | append: i | append: '_name'
        assign role_key = 'member_' | append: i | append: '_role'

        assign member_image = block.settings[image_key]
        assign member_name = block.settings[name_key]
        assign member_role = block.settings[role_key]
      %}

      <div class="ai-team-member-{{ ai_gen_id }}">
        <div class="ai-team-image-wrapper-{{ ai_gen_id }}">
          {% if member_image %}
            <img
              src="{{ member_image | image_url: width: 600 }}"
              alt="{{ member_name | escape }}"
              loading="lazy"
              width="{{ member_image.width }}"
              height="{{ member_image.height }}"
              class="ai-team-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-team-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if member_name != blank %}
          <h3 class="ai-team-name-{{ ai_gen_id }}">{{ member_name }}</h3>
        {% endif %}

        {% if member_role != blank %}
          <p class="ai-team-role-{{ ai_gen_id }}">{{ member_role }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</team-section-{{ ai_gen_id }}>

<script>
  (function() {
    class TeamSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('team-section-{{ ai_gen_id }}', TeamSection{{ ai_gen_id }});
  })();
</script>

