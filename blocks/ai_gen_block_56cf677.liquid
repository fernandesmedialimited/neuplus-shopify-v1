{% doc %}
  @prompt
    A styled ingredients list, 4 columns on desktop , make it full-screen width on desktop
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredients-list-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-ingredients-list__container-{{ ai_gen_id }} {
    width: 100%;
    margin: 0 auto;
  }

  .ai-ingredients-list__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-ingredients-list__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.description_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-ingredients-list__items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.item_spacing }}px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-ingredients-list__item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.icon_spacing }}px;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-ingredients-list__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-ingredients-list__icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
  }

  .ai-ingredients-list__content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-ingredients-list__name-{{ ai_gen_id }} {
    color: {{ block.settings.item_heading_color }};
    font-size: {{ block.settings.item_heading_size }}px;
    font-weight: 600;
    margin: 0 0 4px;
  }

  .ai-ingredients-list__details-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.item_text_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-ingredients-list__items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-ingredients-list-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-ingredients-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ingredients-list__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-ingredients-list__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-ingredients-list__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
    {% endif %}

    <ul class="ai-ingredients-list__items-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign ingredient_name_key = 'ingredient_' | append: i | append: '_name'
          assign ingredient_details_key = 'ingredient_' | append: i | append: '_details'
          assign ingredient_name = block.settings[ingredient_name_key]
          assign ingredient_details = block.settings[ingredient_details_key]
        %}

        {% if ingredient_name != blank %}
          <li class="ai-ingredients-list__item-{{ ai_gen_id }}">
            {% if block.settings.show_icons %}
              <div class="ai-ingredients-list__icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
            {% endif %}
            <div class="ai-ingredients-list__content-{{ ai_gen_id }}">
              <div class="ai-ingredients-list__name-{{ ai_gen_id }}">{{ ingredient_name }}</div>
              {% if ingredient_details != blank %}
                <div class="ai-ingredients-list__details-{{ ai_gen_id }}">{{ ingredient_details }}</div>
              {% endif %}
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

