{% doc %}
  @prompt
    an announcement bar with a heading and a logo with an animated glowing effect. Heading first, then logo., improve glow
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.alignment }};
    gap: {{ block.settings.spacing }}px;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-announcement-bar-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
    line-height: 1.2;
  }

  .ai-announcement-bar-logo-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ai-announcement-bar-logo-{{ ai_gen_id }} {
    height: {{ block.settings.logo_height }}px;
    width: auto;
    display: block;
    position: relative;
    z-index: 3;
    filter: drop-shadow(0 0 8px {{ block.settings.glow_color }}40);
  }

  .ai-announcement-bar-logo-placeholder-{{ ai_gen_id }} {
    height: {{ block.settings.logo_height }}px;
    width: {{ block.settings.logo_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: 4px;
  }

  .ai-announcement-bar-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-announcement-bar-glow-inner-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle, {{ block.settings.glow_color }} 0%, transparent 60%);
    z-index: 1;
    animation: ai-announcement-bar-glow-inner-{{ ai_gen_id }} {{ block.settings.glow_duration }}s ease-in-out infinite;
    filter: blur(8px);
  }

  .ai-announcement-bar-glow-middle-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140%;
    height: 140%;
    border-radius: 50%;
    background: radial-gradient(circle, {{ block.settings.glow_color }} 0%, transparent 65%);
    z-index: 0;
    animation: ai-announcement-bar-glow-middle-{{ ai_gen_id }} {{ block.settings.glow_duration }}s ease-in-out infinite;
    animation-delay: {{ block.settings.glow_duration | divided_by: 6.0 }}s;
    filter: blur(12px);
  }

  .ai-announcement-bar-glow-outer-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 180%;
    height: 180%;
    border-radius: 50%;
    background: radial-gradient(circle, {{ block.settings.glow_color }} 0%, transparent 70%);
    z-index: -1;
    animation: ai-announcement-bar-glow-outer-{{ ai_gen_id }} {{ block.settings.glow_duration }}s ease-in-out infinite;
    animation-delay: {{ block.settings.glow_duration | divided_by: 3.0 }}s;
    filter: blur(16px);
  }

  @keyframes ai-announcement-bar-glow-inner-{{ ai_gen_id }} {
    0%, 100% {
      opacity: {{ block.settings.glow_intensity | divided_by: 100.0 | times: 0.6 }};
      transform: translate(-50%, -50%) scale(0.9);
    }
    50% {
      opacity: {{ block.settings.glow_intensity | divided_by: 100.0 }};
      transform: translate(-50%, -50%) scale(1.1);
    }
  }

  @keyframes ai-announcement-bar-glow-middle-{{ ai_gen_id }} {
    0%, 100% {
      opacity: {{ block.settings.glow_intensity | divided_by: 100.0 | times: 0.4 }};
      transform: translate(-50%, -50%) scale(0.85);
    }
    50% {
      opacity: {{ block.settings.glow_intensity | divided_by: 100.0 | times: 0.7 }};
      transform: translate(-50%, -50%) scale(1.15);
    }
  }

  @keyframes ai-announcement-bar-glow-outer-{{ ai_gen_id }} {
    0%, 100% {
      opacity: {{ block.settings.glow_intensity | divided_by: 100.0 | times: 0.3 }};
      transform: translate(-50%, -50%) scale(0.8);
    }
    50% {
      opacity: {{ block.settings.glow_intensity | divided_by: 100.0 | times: 0.5 }};
      transform: translate(-50%, -50%) scale(1.2);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
    }

    .ai-announcement-bar-content-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing | times: 0.8 }}px;
    }

    .ai-announcement-bar-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-announcement-bar-logo-{{ ai_gen_id }} {
      height: {{ block.settings.logo_height | times: 0.8 }}px;
    }

    .ai-announcement-bar-logo-placeholder-{{ ai_gen_id }} {
      height: {{ block.settings.logo_height | times: 0.8 }}px;
      width: {{ block.settings.logo_height | times: 0.8 }}px;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-bar-content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-announcement-bar-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-announcement-bar-logo-wrapper-{{ ai_gen_id }}">
      <div class="ai-announcement-bar-glow-outer-{{ ai_gen_id }}"></div>
      <div class="ai-announcement-bar-glow-middle-{{ ai_gen_id }}"></div>
      <div class="ai-announcement-bar-glow-inner-{{ ai_gen_id }}"></div>
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ block.settings.logo.alt | escape }}"
          class="ai-announcement-bar-logo-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
        >
      {% else %}
        <div class="ai-announcement-bar-logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Special Announcement"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Spacing between items",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Glow effect"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "glow_intensity",
      "label": "Glow intensity",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "glow_duration",
      "label": "Animation duration",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "unit": "s",
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
