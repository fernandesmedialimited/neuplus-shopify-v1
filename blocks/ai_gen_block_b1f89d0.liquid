{% doc %}
  @prompt
    Create a two-column "Ingredients with Purpose" section. Left column: small uppercase eyebrow label, large bold heading, grey subheading paragraph, then a repeating list of ingredients — each row has a circular image (64px), ingredient name in bold, a dosage value aligned right in an accent olive-green color, and a grey description line below the name. Rows are separated by thin horizontal dividers. Right column: a single large rounded-corner product image, sticky on scroll on desktop. Stack into one column on mobile, with the image moving above the text.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredients-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-ingredients-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-ingredients-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-ingredients-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: {{ block.settings.eyebrow_color }};
    margin: 0;
    font-weight: 500;
  }

  .ai-ingredients-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-ingredients-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-ingredients-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ai-ingredient-item-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.image_size }}px 1fr auto;
    gap: {{ block.settings.item_gap }}px;
    align-items: center;
    padding: {{ block.settings.item_padding }}px 0;
    border-bottom: {{ block.settings.divider_width }}px solid {{ block.settings.divider_color }};
  }

  .ai-ingredient-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-ingredient-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: 50%;
    object-fit: cover;
  }

  .ai-ingredient-image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: 50%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-ingredient-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-ingredient-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-ingredient-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_name_size }}px;
    font-weight: 700;
    color: {{ block.settings.ingredient_name_color }};
    margin: 0;
  }

  .ai-ingredient-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_description_size }}px;
    color: {{ block.settings.ingredient_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-ingredient-dosage-{{ ai_gen_id }} {
    font-size: {{ block.settings.dosage_size }}px;
    font-weight: 600;
    color: {{ block.settings.dosage_color }};
    white-space: nowrap;
  }

  .ai-ingredients-image-column-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-ingredients-image-sticky-{{ ai_gen_id }} {
    position: sticky;
    top: 100px;
  }

  .ai-ingredients-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.product_image_radius }}px;
    object-fit: cover;
  }

  .ai-ingredients-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    border-radius: {{ block.settings.product_image_radius }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-ingredients-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ingredients-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-ingredients-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-ingredients-image-column-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-ingredients-image-sticky-{{ ai_gen_id }} {
      position: static;
    }

    .ai-ingredients-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-ingredient-item-{{ ai_gen_id }} {
      grid-template-columns: {{ block.settings.mobile_image_size }}px 1fr auto;
    }

    .ai-ingredient-image-{{ ai_gen_id }},
    .ai-ingredient-image-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_size }}px;
      height: {{ block.settings.mobile_image_size }}px;
    }
  }
{% endstyle %}

<ingredients-section-{{ ai_gen_id }}
  class="ai-ingredients-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-ingredients-container-{{ ai_gen_id }}">
    <div class="ai-ingredients-content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-ingredients-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-ingredients-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="ai-ingredients-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}

      <div class="ai-ingredients-list-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign ingredient_name_key = 'ingredient_' | append: i | append: '_name'
            assign ingredient_description_key = 'ingredient_' | append: i | append: '_description'
            assign ingredient_dosage_key = 'ingredient_' | append: i | append: '_dosage'
            assign ingredient_image_key = 'ingredient_' | append: i | append: '_image'

            assign ingredient_name = block.settings[ingredient_name_key]
            assign ingredient_description = block.settings[ingredient_description_key]
            assign ingredient_dosage = block.settings[ingredient_dosage_key]
            assign ingredient_image = block.settings[ingredient_image_key]
          %}

          {% if ingredient_name != blank %}
            <div class="ai-ingredient-item-{{ ai_gen_id }}">
              <div>
                {% if ingredient_image %}
                  <img
                    src="{{ ingredient_image | image_url: width: 128 }}"
                    alt="{{ ingredient_name | escape }}"
                    class="ai-ingredient-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="128"
                    height="128"
                  >
                {% else %}
                  <div class="ai-ingredient-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-ingredient-info-{{ ai_gen_id }}">
                <h3 class="ai-ingredient-name-{{ ai_gen_id }}">{{ ingredient_name }}</h3>
                {% if ingredient_description != blank %}
                  <p class="ai-ingredient-description-{{ ai_gen_id }}">{{ ingredient_description }}</p>
                {% endif %}
              </div>

              {% if ingredient_dosage != blank %}
                <div class="ai-ingredient-dosage-{{ ai_gen_id }}">{{ ingredient_dosage }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-ingredients-image-column-{{ ai_gen_id }}">
      <div class="ai-ingredients-image-sticky-{{ ai_gen_id }}">
        {% if block.settings.product_image %}
          <img
            src="{{ block.settings.product_image | image_url: width: 1200 }}"
            alt="{{ block.settings.product_image.alt | escape }}"
            class="ai-ingredients-product-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.product_image.width }}"
            height="{{ block.settings.product_image.height }}"
          >
        {% else %}
          <div class="ai-ingredients-product-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
            <div class="ai-ingredients-empty-state-{{ ai_gen_id }}">
              Next, add a product image
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</ingredients-section-{{ ai_gen_id }}>

<script>
  (function() {
    class IngredientsSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('ingredients-section-{{ ai_gen_id }}', IngredientsSection{{ ai_gen_id }});
  })();
</script>

