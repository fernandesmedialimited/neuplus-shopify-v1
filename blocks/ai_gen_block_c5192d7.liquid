{% doc %}
  @prompt
    Meet the team - Horizontal carousel with scroll.
    
    Image, Name, Description.
    
    6 team members total, Add title - NEU+ Ambassadors
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-team-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-team-carousel-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.title_spacing }}px;
  }

  .ai-team-carousel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-team-carousel-container-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
  }

  .ai-team-carousel-container-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-team-carousel-container-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-team-carousel-container-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 4px;
  }

  .ai-team-carousel-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding }}px 0;
  }

  .ai-team-member-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-team-member-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: {{ block.settings.placeholder_bg_color }};
  }

  .ai-team-member-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-team-member-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-team-member-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-team-member-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-team-member-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    font-weight: 700;
    color: {{ block.settings.name_color }};
    margin: 0;
  }

  .ai-team-member-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-team-member-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}px;
    }

    .ai-team-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }
  }
{% endstyle %}

<team-carousel-{{ ai_gen_id }} class="ai-team-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <div class="ai-team-carousel-header-{{ ai_gen_id }}">
      <h2 class="ai-team-carousel-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    </div>
  {% endif %}

  <div class="ai-team-carousel-container-{{ ai_gen_id }}">
    <div class="ai-team-carousel-wrapper-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'member_' | append: i | append: '_image'
          assign name_key = 'member_' | append: i | append: '_name'
          assign description_key = 'member_' | append: i | append: '_description'

          assign member_image = block.settings[image_key]
          assign member_name = block.settings[name_key]
          assign member_description = block.settings[description_key]
        %}

        <div class="ai-team-member-{{ ai_gen_id }}">
          <div class="ai-team-member-image-wrapper-{{ ai_gen_id }}">
            {% if member_image %}
              <img
                src="{{ member_image | image_url: width: 600 }}"
                alt="{{ member_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="600"
                class="ai-team-member-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-team-member-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-team-member-content-{{ ai_gen_id }}">
            {% if member_name != blank %}
              <h3 class="ai-team-member-name-{{ ai_gen_id }}">{{ member_name }}</h3>
            {% endif %}

            {% if member_description != blank %}
              <div class="ai-team-member-description-{{ ai_gen_id }}">{{ member_description }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</team-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class TeamCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-team-carousel-container-{{ ai_gen_id }}');
      }
    }

    customElements.define('team-carousel-{{ ai_gen_id }}', TeamCarousel{{ ai_gen_id }});
  })();
</script>

