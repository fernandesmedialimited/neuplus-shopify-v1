{{ 'neu-product.css' | asset_url | stylesheet_tag }}

<div
  class="neu neu-section"
  style="--neu-pad-top: {{ section.settings.padding_top }}px; --neu-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="neu-page">
    <div class="neu-certs neu-narrow">
      {%- if section.settings.eyebrow != blank -%}
        <p class="neu-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="neu-h2">{{ section.settings.heading }}</h2>

      {%- liquid
        assign cert_count = section.blocks.size | at_least: 1 | at_most: 6
        assign cert_cols_md = 3
        if cert_count == 4 or cert_count < 3
          assign cert_cols_md = cert_count | at_most: 2
        endif
      -%}
      <div class="neu-certs__grid" style="--neu-cert-cols: {{ cert_count }}; --neu-cert-cols-md: {{ cert_cols_md }}">
        {%- for block in section.blocks -%}
          <div class="neu-certs__card" {{ block.shopify_attributes }}>
            <div class="neu-certs__logo">
              {%- if block.settings.logo -%}
                {{ block.settings.logo | image_url: height: 128 | image_tag: loading: 'lazy', alt: block.settings.logo.alt | default: block.settings.title }}
              {%- elsif block.settings.icon != 'none' -%}
                <span class="neu-certs__icon">{% render 'neu-icon', icon: block.settings.icon %}</span>
              {%- endif -%}
            </div>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .neu-certs__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--neu-cream-2, #f2efe8);
    color: var(--neu-ink, #0b0b0b);
    font-size: 32px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NEU+ certifications",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Made right. Tested independently."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Certifications & standards"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "cert",
      "name": "Certification",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Optional. When no logo is set, the icon below is shown."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "flask", "label": "Lab tested" },
            { "value": "medal", "label": "Medal" },
            { "value": "check", "label": "Check" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sprout", "label": "Sprout" },
            { "value": "no-gmo", "label": "No GMO" },
            { "value": "factory", "label": "Factory" },
            { "value": "heart", "label": "Heart" },
            { "value": "none", "label": "None" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Informed Sport"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Batch tested"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "NEU+ certifications",
      "blocks": [
        { "type": "cert" },
        { "type": "cert", "settings": { "icon": "leaf", "title": "Vegan", "text": "Plant-based formula" } },
        { "type": "cert", "settings": { "icon": "no-gmo", "title": "GMO-free", "text": "No modified ingredients" } },
        { "type": "cert", "settings": { "icon": "factory", "title": "Made in Britain", "text": "Manufactured in the UK" } }
      ]
    }
  ]
}
{% endschema %}
