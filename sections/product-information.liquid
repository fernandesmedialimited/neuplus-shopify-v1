<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
  %}

  <sticky-add-to-cart
    class="sticky-add-to-cart custom-sticky-bar-wrapper"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="custom-sticky-bar"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      <div class="custom-sticky-bar__container">
        
        <div class="custom-sticky-bar__info">
          <span class="custom-sticky-bar__label">YOUR SELECTION</span>
          <p class="custom-sticky-bar__title" data-testid="sticky-variant-title">
            {% if product.has_only_default_variant %}
              {{ product.title | escape }}
            {% else %}
              {{ current_variant.title | escape }}
            {% endif %}
          </p>
          <p class="custom-sticky-bar__subtitle">
            {{ current_variant.metafields.custom.subtitle | default: "Delivered every 4 weeks" }}
          </p>
        </div>

        <div class="custom-sticky-bar__price-block">
          <span class="custom-sticky-bar__label">TOTAL TODAY</span>
          <div class="custom-sticky-bar__price" data-testid="sticky-price-display">
            {% render 'price', product_resource: product, show_sale_price_first: true %}
          </div>
        </div>

        <div class="custom-sticky-bar__actions">
          <div class="custom-sticky-bar__quantity" {% if initial_quantity <= 1 %}style="display: none;"{% endif %}>
            <span ref="quantityNumber">{{ initial_quantity }}</span>
          </div>

          <button
            type="button"
            class="custom-sticky-bar__button button"
            ref="addToCartButton"
            on:click="/handleAddToCartClick"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            <span class="add-to-cart-text">
              <span class="svg-wrapper">
                {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
              </span>
              <span class="add-to-cart-text__content">
                {%- if current_variant.available -%}
                  ADD TO CART — <span ref="buttonPrice">{{ current_variant.price | money }}</span>
                {%- elsif current_variant == blank -%}
                  {{- 'products.product.unavailable' | t -}}
                {%- else -%}
                  {{- 'products.product.sold_out' | t -}}
                {%- endif -%}
              </span>
            </span>
            <span class="add-to-cart__added" style="display:none;">
              <span class="svg-wrapper add-to-cart__added-icon">
                {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
              </span>
            </span>
          </button>
        </div>

      </div>
    </div>
  </sticky-add-to-cart>
{% endif %}

{% render 'product-information-content',
  product: closest.product,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% stylesheet %}
  .custom-sticky-bar-wrapper {
    display: block;
  }

  .custom-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #ffffff;
    border-top: 1px solid #e5e7eb;
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.08);
    z-index: calc(var(--layer-sticky, 100) + 10);
    transform: translateY(100%);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease, visibility 0.4s;
  }

  .custom-sticky-bar[data-stuck='true'] {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .custom-sticky-bar {
    transform: translateY(100%);
    opacity: 0;
    visibility: hidden;
  }

  .custom-sticky-bar__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .custom-sticky-bar__label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: #6b7280;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .custom-sticky-bar__info, 
  .custom-sticky-bar__price-block {
    display: flex;
    flex-direction: column;
  }

  .custom-sticky-bar__title {
    font-size: 16px;
    font-weight: 700;
    color: #2b4c2b;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .custom-sticky-bar__subtitle {
    font-size: 13px;
    color: #4b5563;
    margin: 2px 0 0 0;
  }

  .custom-sticky-bar__price {
    font-size: 18px;
    font-weight: 800;
    color: #000;
  }

  .custom-sticky-bar__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .custom-sticky-bar__button {
    background: #000000;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 16px 32px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 280px;
    transition: background 0.2s ease;
  }

  .custom-sticky-bar__button:hover {
    background: #1f2937;
  }

  .custom-sticky-bar__button[disabled] {
    background: #d1d5db;
    cursor: not-allowed;
  }

  .add-to-cart-text {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .svg-wrapper {
    display: flex;
    align-items: center;
  }

  .svg-wrapper svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Mobile Adjustments */
  @media screen and (max-width: 768px) {
    .custom-sticky-bar__container {
      flex-direction: column;
      align-items: stretch;
      padding: 16px;
      gap: 16px;
    }

    .custom-sticky-bar__info, 
    .custom-sticky-bar__price-block {
      align-items: center;
      text-align: center;
    }

    .custom-sticky-bar__actions {
      width: 100%;
    }

    .custom-sticky-bar__button {
      width: 100%;
      min-width: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}