            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"11\" cy=\"11\" r=\"7\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M21 21l-4.35-4.35\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>"
          }
        },
        {
          "type": "story_point",
          "settings": {
            "title": "THE RESEARCH",
            "description": "We spent years studying NAD+ and its role in energy, focus and recovery.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M9 2v6L4 20a1 1 0 001 2h14a1 1 0 001-2L15 8V2M9 2h6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/></svg>"
          }
        },
        {
          "type": "story_point",
          "settings": {
            "title": "THE SOLUTION",
            "description": "We developed NEU+ — a bioavailable, great-tasting daily shot with clinically studied ingredients.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 8v8M8 12h8\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>"
          }
        },
        {
          "type": "story_point",
          "settings": {
            "title": "MADE IN BRITAIN",
            "description": "Manufactured to the highest standards in the UK, in Informed Sport certified facilities.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 21V9l8-5 8 5v12M4 21h16M9 21v-6h6v6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/></svg>"
          }
