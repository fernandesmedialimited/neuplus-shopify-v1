ground_color":"{{ settings.color_palette.background }}","padding-block-start":0,"padding-block-end":48}},"section_TyM7fQ":{"type":"section","blocks":{"text_anCJt7":{"type":"text","name":"t:names.text","settings":{"text":"<h3><\/h3><h3><\/h3><h3><strong>Why Most Supplements Fall Short<\/strong><\/h3><p>Many supplements look good on the label but fail where it matters most: inside your cells.<\/p><p>Common issues include:<\/p><ul><li>Doses far below levels used in research<\/li><li>Poor bioavailability, meaning ingredients are not effectively absorbed<\/li><li>Single-ingredient formulas with no synergy<\/li><li>A focus on symptoms rather than root causes<\/li><\/ul><p>Neu+ was developed to address these problems head-on. Our formulations prioritise effective dosing, absorbable formats, and complementary ingredients that work better together.<\/p><p><strong>Wellness That Works at the Cellular Level<\/strong><\/p><p>Ageing is not just about getting older. It is<br\/>driven by a series of biological processes that affect how efficiently your cells produce energy, repair damage, and respond to stress.<\/p><p>Neu+ is designed to support your body’s natural NAD+ production, a molecule essential for cellular energy, repair, and long term resilience. As NAD+ levels naturally decline with age, supporting these pathways becomes increasingly important.<\/p><p>Each daily 60ml Neu+ shot is formulated to:<\/p><ul><li>Fuel cellular energy production<\/li><li>Support healthy ageing processes<\/li><li>Promote mental focus and clarity<\/li><li>Aid recovery from physical and mental stress<\/li><li>Help protect cells from oxidative damage<\/li><\/ul><p>This is wellness at its foundation, supporting the systems your body relies on every day.<\/p><p><strong>Longevity Over Quick Fixes<\/strong><\/p><p>Anti-ageing focuses on reacting to damage once it has already happened. Longevity is about supporting your body before that damage accumulates.<\/p><p>Neu+ is built around a proactive approach to health, supporting your cells consistently over time rather than chasing short-term results. Small daily habits compound, and<br\/>longevity starts with what you do every day.<\/p><p>We didn’t create Neu+ to follow wellness trends. We created it to <a href=\"https:\/\/www.neu-plus.com\/pages\/our-story\">simplify them.<\/a><\/p><p>           <\/p><p><\/p><p><\/p><p><\/p><p><\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_anCJt7"],"name":"t:names.custom_section","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"page-width","section_height":"small","section_height_custom":50,"background_media":"none","background_color":"{{ settings.color_palette.foreground }}","video_position":"cover","background_image_position":"cover","toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0}},"section_nAeMq6":{"type":"section","blocks":{"text_mWLkJF":{"type":"text","name":"t:names.heading","settings":{"text":"<h3>Frequently asked questions<\/h3>","width":"fit-content","max_width":"narrow","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","background":false,"background_color":"#00000026","corner_radius":0,"