{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

{%- assign final_link = link -%}

{%- if block_settings.is_subscribe_button and block_settings.subscription_product != blank -%}
  {%- assign sub_product = block_settings.subscription_product -%}
  {%- assign variant_id = sub_product.selected_or_first_available_variant.id -%}
  {%- assign selling_plan_id = block_settings.selling_plan_id | strip -%}
  
  {%- if variant_id -%}
    {%- capture final_link -%}/cart/add?id={{ variant_id }}&quantity=1{% if selling_plan_id != blank %}&selling_plan={{ selling_plan_id }}{% endif %}&return_to=/checkout{%- endcapture -%}
  {%- endif -%}
{%- endif -%}

<a
  {% if final_link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ final_link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    {{ block_settings.style_class }}--{{ block.id }}
  "
  style="{% render 'size-style', settings: block_settings %}"
  {%- if block_settings.open_in_new_tab and block_settings.is_subscribe_button == false -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {{ block_settings.label }}
</a>